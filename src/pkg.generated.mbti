  issues : Array[ValidationIssue]
  records : Int
  shapes : Int
  normalized : Bool
} derive(@debug.Debug)
pub fn ValidationResult::error_count(Self) -> Int
pub fn ValidationResult::is_valid(Self) -> Bool
pub fn ValidationResult::summary(Self) -> String
pub fn ValidationResult::warning_count(Self) -> Int

pub enum ValidationStatus {
  ValidInput
  ValidWithWarnings
  InvalidInput
} derive(Eq, @debug.Debug)

pub enum ZeroSuppression {
  LeadingZeros
  TrailingZeros
  ExplicitZeros
} derive(Eq, @debug.Debug)

